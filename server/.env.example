# EduFlow Backend Environment Variables

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduflow_db?schema=public"

# JWT Auth Secret
JWT_SECRET="eduflow-super-secret-jwt-key-2026"

# Gemini API Key (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
GEMINI_API_KEY=""

# File Storage Configuration (AWS S3 / Cloudflare R2 / Local Disk fallback)
# Leave empty for local filesystem uploads in development
S3_BUCKET_NAME=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
PUBLIC_UPLOADS_URL="http://localhost:4000/uploads"
